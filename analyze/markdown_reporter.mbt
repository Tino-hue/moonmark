/// Markdown 报告渲染器
///
/// 生成可直接嵌入 GitHub README / PR 描述的 Markdown 格式报告。

// ========== 公共入口 ==========

///|
/// 将 AnalysisReport 渲染为 Markdown 格式字符串
pub fn render_markdown_report(
  report : AnalysisReport,
  graph : @graph.DependencyGraph,
  root_id : String,
) -> String {
  let lines : Array[String] = []

  // 标题
  lines.push("# MoonBit Depsight Report")
  lines.push("")

  // 概览
  lines.push("## Overview")
  lines.push("")
  lines.push("| Metric | Value |")
  lines.push("|--------|-------|")
  lines.push(
    "| Health Score | **" + report.overall_score.to_string() + "**/100 |",
  )
  lines.push("| Total Nodes | " + report.node_count.to_string() + " |")

  let critical_count = md_count_by_level(
    report.diagnostics,
    @report.level_critical(),
  )
  let warning_count = md_count_by_level(
    report.diagnostics,
    @report.level_warning(),
  )
  let info_count = md_count_by_level(report.diagnostics, @report.level_info())
  lines.push("| Critical | " + critical_count.to_string() + " |")
  lines.push("| Warning | " + warning_count.to_string() + " |")
  lines.push("| Info | " + info_count.to_string() + " |")
  lines.push("")

  // 健康分详情
  if report.health_scores.length() > 0 {
    lines.push("## Health Scores")
    lines.push("")
    lines.push("| Node | Total | Fresh | Comply | DepDen | Size | Actv |")
    lines.push("|------|-------|-------|--------|--------|------|------|")
    for s in report.health_scores {
      let node_short = md_truncate_node_id(s.node_id)
      lines.push(
        "| " +
        node_short +
        " | " +
        s.total.to_string() +
        " | " +
        s.freshness.to_string() +
        " | " +
        s.compliance.to_string() +
        " | " +
        s.deprecated_density.to_string() +
        " | " +
        s.size_reasonableness.to_string() +
        " | " +
        s.activity.to_string() +
        " |",
      )
    }
    lines.push("")
  }

  // 诊断
  if report.diagnostics.length() > 0 {
    lines.push("## Diagnostics")
    lines.push("")

    // Critical
    if critical_count > 0 {
      lines.push("### Critical")
      lines.push("")
      for d in report.diagnostics {
        if d.is_critical() {
          lines.push("- **" + d.code + "** \u2014 " + d.message)
          for sugg in d.suggestions {
            lines.push("  - " + sugg)
          }
        }
      }
      lines.push("")
    }

    // Warning
    if warning_count > 0 {
      lines.push("### Warning")
      lines.push("")
      for d in report.diagnostics {
        if d.is_warning() {
          lines.push("- **" + d.code + "** \u2014 " + d.message)
          for sugg in d.suggestions {
            lines.push("  - " + sugg)
          }
        }
      }
      lines.push("")
    }

    // Info
    if info_count > 0 {
      lines.push("### Info")
      lines.push("")
      for d in report.diagnostics {
        if d.is_info() {
          lines.push("- **" + d.code + "** \u2014 " + d.message)
          for sugg in d.suggestions {
            lines.push("  - " + sugg)
          }
        }
      }
      lines.push("")
    }
  } else {
    lines.push("## Diagnostics")
    lines.push("")
    lines.push("No issues found.")
    lines.push("")
  }

  // 依赖树
  lines.push("## Dependency Tree")
  lines.push("")
  lines.push("```")
  let tree = graph.render_tree(root_id, 99)
  lines.push(tree)
  lines.push("```")
  lines.push("")

  // 页脚
  lines.push("---")
  lines.push("*Generated by MoonBit Depsight v0.5.0*")

  md_join_lines(lines)
}

// ========== 内部辅助 ==========

///|
fn md_count_by_level(
  diagnostics : Array[@report.Diagnostic],
  level : String,
) -> Int {
  let mut count = 0
  for d in diagnostics {
    if d.level == level {
      count = count + 1
    }
  }
  count
}

///|
fn md_truncate_node_id(node_id : String) -> String {
  if node_id.length() <= 30 {
    node_id
  } else {
    let idx = md_str_find_last(node_id, '/')
    if idx >= 0 {
      node_id[idx + 1:node_id.length()].to_owned()
    } else {
      node_id
    }
  }
}

///|
fn md_str_find_last(s : String, ch : UInt16) -> Int {
  let mut i = s.length() - 1
  while i >= 0 {
    if s[i] == ch {
      return i
    }
    i = i - 1
  }
  -1
}

///|
fn md_join_lines(lines : Array[String]) -> String {
  let mut result = ""
  let mut i = 0
  while i < lines.length() {
    if i > 0 {
      result = result + "\n"
    }
    result = result + lines[i]
    i = i + 1
  }
  result
}
