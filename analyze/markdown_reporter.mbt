/// Markdown 报告渲染器
///
/// 生成可直接嵌入 GitHub README / PR 描述的 Markdown 格式报告。

// ========== 公共入口 ==========

///|
/// 将 AnalysisReport 渲染为 Markdown 格式字符串
pub fn render_markdown_report(
  report : AnalysisReport,
  graph : @graph.DependencyGraph,
  root_id : String,
) -> String {
  let buf = StringBuilder()

  // 标题
  buf <+ "# MoonBit Depsight Report\n\n"

  // 概览
  buf <+ "## Overview\n\n"
  buf <+ "| Metric | Value |\n"
  buf <+ "|--------|-------|\n"
  buf <+
    $|"| Health Score | **\{report.overall_score}**/100 |\n"
  buf <+
    $|"| Total Nodes | \{report.node_count} |\n"

  let critical_count = md_count_by_level(
    report.diagnostics,
    @report.level_critical(),
  )
  let warning_count = md_count_by_level(
    report.diagnostics,
    @report.level_warning(),
  )
  let info_count = md_count_by_level(report.diagnostics, @report.level_info())
  buf <+
    $|"| Critical | \{critical_count} |\n"
  buf <+
    $|"| Warning | \{warning_count} |\n"
  buf <+
    $|"| Info | \{info_count} |\n\n"

  // 健康分详情
  if report.health_scores.length() > 0 {
    buf <+ "## Health Scores\n\n"
    buf <+ "| Node | Total | Fresh | Comply | DepDen | Size | Actv |\n"
    buf <+ "|------|-------|-------|--------|--------|------|------|\n"
    for s in report.health_scores {
      let node_short = md_truncate_node_id(s.node_id)
      buf <+
        $|"| \{node_short} | \{s.total} | \{s.freshness} | \{s.compliance} | \{s.deprecated_density} | \{s.size_reasonableness} | \{s.activity} |\n"
    }
    buf <+ "\n"
  }

  // 诊断
  if report.diagnostics.length() > 0 {
    buf <+ "## Diagnostics\n\n"

    // Critical
    if critical_count > 0 {
      buf <+ "### Critical\n\n"
      for d in report.diagnostics {
        if d.is_critical() {
          buf <+
            $|"- **\{d.code}** \u{2014} \{d.message}\n"
          for sugg in d.suggestions {
            buf <+
              $|"  - \{sugg}\n"
          }
        }
      }
      buf <+ "\n"
    }

    // Warning
    if warning_count > 0 {
      buf <+ "### Warning\n\n"
      for d in report.diagnostics {
        if d.is_warning() {
          buf <+
            $|"- **\{d.code}** \u{2014} \{d.message}\n"
          for sugg in d.suggestions {
            buf <+
              $|"  - \{sugg}\n"
          }
        }
      }
      buf <+ "\n"
    }

    // Info
    if info_count > 0 {
      buf <+ "### Info\n\n"
      for d in report.diagnostics {
        if d.is_info() {
          buf <+
            $|"- **\{d.code}** \u{2014} \{d.message}\n"
          for sugg in d.suggestions {
            buf <+
              $|"  - \{sugg}\n"
          }
        }
      }
      buf <+ "\n"
    }
  } else {
    buf <+ "## Diagnostics\n\n"
    buf <+ "No issues found.\n\n"
  }

  // 依赖树
  buf <+ "## Dependency Tree\n\n"
  buf <+ "```\n"
  let tree = graph.render_tree(root_id, 99)
  buf.write_string(tree)
  buf <+ "\n```\n\n"

  // 页脚
  buf <+ "---\n"
  buf <+ "*Generated by MoonBit Depsight v0.5.0*\n"

  buf.to_string()
}

// ========== 内部辅助 ==========

///|
fn md_count_by_level(
  diagnostics : Array[@report.Diagnostic],
  level : String,
) -> Int {
  let mut count = 0
  for d in diagnostics {
    if d.level == level {
      count = count + 1
    }
  }
  count
}

///|
fn md_truncate_node_id(node_id : String) -> String {
  if node_id.length() <= 30 {
    node_id
  } else {
    let idx = md_str_find_last(node_id, '/')
    if idx >= 0 {
      node_id[idx + 1:node_id.length()].to_owned()
    } else {
      node_id
    }
  }
}

///|
fn md_str_find_last(s : String, ch : UInt16) -> Int {
  let mut i = s.length() - 1
  while i >= 0 {
    if s[i] == ch {
      return i
    }
    i = i - 1
  }
  -1
}
