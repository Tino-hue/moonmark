{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "#|", "close": "|#" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "wordPattern": "(\\w+)(?!['\"])\\b",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((fn|struct|enum|trait|impl|if|else|match|guard|while|for|loop|try)\\b.*|[^/]*\\{[^}/]*$)",
    "decreaseIndentPattern": "^\\s*(\\}|\\])"
  }
}
