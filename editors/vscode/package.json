{
  "name": "moonbit-highlight",
  "displayName": "MoonBit Highlight",
  "description": "Tree-sitter powered syntax highlighting for MoonBit",
  "version": "0.1.0",
  "publisher": "moonbit",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "moonbit",
    "mbt",
    "tree-sitter",
    "syntax-highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Tino-hue/moonmark"
  },
  "contributes": {
    "languages": [
      {
        "id": "moonbit",
        "aliases": [
          "MoonBit",
          "moonbit",
          "mbt"
        ],
        "extensions": [
          ".mbt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moonbit",
        "scopeName": "source.moonbit",
        "path": "../../queries/highlights.scm",
        "injectTo": [
          "source.moonbit"
        ]
      }
    ],
    "themes": [
      {
        "label": "MoonBit Dark (Official)",
        "uiTheme": "vs-dark",
        "path": "./themes/moonbit-dark.json"
      },
      {
        "label": "MoonBit Light (Official)",
        "uiTheme": "vs",
        "path": "./themes/moonbit-light.json"
      }
    ]
  }
}
