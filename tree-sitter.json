      ],
      "indents": [
        "queries/indents.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ],
      "injection-regex": "moonbit"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "MoonBit grammar for tree-sitter",
    "authors": [
      {
        "name": "Tino-hue"
      }
    ],
    "links": {
      "repository": "https://github.com/Tino-hue/moonmark"
    }
  },
